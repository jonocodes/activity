# Copy to .env for local runs (direnv loads it). In GitHub, set these as Actions variables instead;
# GH_PAT is an Actions secret. Every ACTIVITY_* setting is optional. See docs/design.md#settings.

# Fine-grained token, "Public repositories (read-only)", no extra permissions.
GH_PAT=

# ACTIVITY_USER=octocat                       # defaults to the repo owner
# ACTIVITY_TITLE="What I've been doing on GitHub"
# ACTIVITY_TIMEZONE=America/Los_Angeles       # which day an item falls on; default UTC
# ACTIVITY_FAVORITES=octocat/hello-world,someorg/upstream-project   # in display order; none by default
# ACTIVITY_SECTIONS=profile,stats,heatmap,feed,projects   # add habits for busiest hours and weekdays
# ACTIVITY_FEED_COMMENTS=false
